# LLMs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Vector DB
PINECONE_API_KEY=
PINECONE_INDEX_NAME=signal

# Database
DATABASE_URL=       # Supabase PostgreSQL connection string
REDIS_URL=

# Data Sources
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=signal/1.0

# Evaluation
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=signal

# Cost controls
MAX_TOKENS_PER_CALL=2000
COLLECT_INTERVAL_HOURS=24
DAILY_BUDGET_USD=2.00

# Feature flags
ENABLE_PLAYWRIGHT=true

# Reliability
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_TIMEOUT_MS=1800000

# Retrieval
COHERE_API_KEY=
RAG_EVAL_FAITHFULNESS_THRESHOLD=0.75
RERANKER_MIN_RELEVANCE_SCORE=0.4
HYBRID_RETRIEVAL_TOP_K=20
RERANKER_TOP_K=10
CITATION_ENFORCEMENT_THRESHOLD=0.75

# Latency tracking
LATENCY_TRACKING_ENABLED=true
